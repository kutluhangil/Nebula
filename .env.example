# Copy to .env.local and fill in. Every variable here is optional: without them
# the app runs against public, key-free endpoints and NASA's shared DEMO_KEY.

# Free at https://api.nasa.gov. Backs the Astronomy Picture of the Day and the
# near-Earth object feed. Without it both fall back to DEMO_KEY, which NASA rate
# limits to 30 requests/hour/IP — enough to develop against, not to deploy.
NASA_API_KEY=

# Optional. When set, the daily planet report is generated by the model instead
# of the built-in template. The route rate limits callers, but this key spends
# real money — leave it empty unless you want that.
OPENAI_API_KEY=

# Canonical origin for metadata, canonical URLs, the sitemap and Open Graph
# images. On Vercel this is derived from the deployment host automatically; set
# it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=
